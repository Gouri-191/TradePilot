# ====================================================================
# TradePilot Delta Exchange Configuration
# ====================================================================
# DO NOT commit real API secrets to source control.
# Copy this file to .env and insert your own Delta Exchange API keys.
#
# Obtain your Delta Exchange Testnet API key from:
# https://testnet.delta.exchange -> Settings -> API Keys
# ====================================================================

# Your Delta Exchange API Key (Provided by user)
DELTA_API_KEY=your_delta_exchange_api_key_here

# Your Delta Exchange API Secret (Optional for market data, required for authenticated orders)
DELTA_API_SECRET=your_delta_exchange_api_secret_here

# Network environment: "testnet" (default) or "production"
ENVIRONMENT=testnet

# Delta Exchange Testnet endpoints
DELTA_TESTNET_API_URL=https://cdn.testnet.delta.exchange
DELTA_TESTNET_ORDER_URL=https://api.testnet.delta.exchange

# Server settings
PORT=8000
HOST=127.0.0.1
DEBUG=True
